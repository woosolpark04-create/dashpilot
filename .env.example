# Supabase project settings.
# Copy this file to .env.local and fill in real values from your Supabase
# project. .env.local is gitignored — never commit real credentials.

# Public (safe to expose to the browser; used by both the browser and
# server Supabase clients in src/lib/supabase/)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Base URL used to build the "Invite user" email's redirect link
# (src/lib/users/actions.ts). Public and safe to expose. Defaults to
# http://localhost:3000 if unset — set this to your deployed domain in
# production.
NEXT_PUBLIC_SITE_URL=

# SERVER-ONLY — never prefix with NEXT_PUBLIC_, never import this into a
# Client Component, never log it, never commit a real value. Grants full
# admin access to this Supabase project (bypasses RLS entirely). Required
# only for the admin-only "Invite user" flow (src/lib/supabase/admin.ts,
# guarded at build time by the `server-only` package). Get it from the
# Supabase dashboard → Settings → API → secret key.
SUPABASE_SECRET_KEY=
